# From Supabase → Project Settings → Database
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[YOUR_ANON_KEY]

# From UploadThing Dashboard
UPLOADTHING_TOKEN=[YOUR_TOKEN]
UPLOADTHING_SECRET=sk_live_[YOUR_SECRET]
UPLOADTHING_APP_ID=[YOUR_APP_ID]

# App URL
NEXT_PUBLIC_APP_URL=http://your-app-url.com