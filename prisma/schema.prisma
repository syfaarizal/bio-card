generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  username  String    @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  profile   Profile?
}

model Profile {
  id           String        @id @default(cuid())
  userId       String        @unique
  slug         String        @unique
  displayName  String?
  bio          String?
  location     String?
  birthday     DateTime?
  tags         String[]
  themeId      String        @default("default")
  themeVersion Int           @default(1)
  status       ProfileStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  images       Image[]
  music        Music?
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  links        SocialLinks?
  views        ViewLog[]
}

model SocialLinks {
  id        String  @id @default(cuid())
  profileId String  @unique
  instagram String?
  tiktok    String?
  twitter   String?
  youtube   String?
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Music {
  id         String  @id @default(cuid())
  profileId  String  @unique
  spotifyUrl String?
  songTitle  String?
  artistName String?
  albumArt   String?
  profile    Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model Image {
  id        String    @id @default(cuid())
  profileId String
  type      ImageType
  url       String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ViewLog {
  id        String   @id @default(cuid())
  profileId String
  ip        String
  country   String?
  device    String?
  referrer  String?
  viewedAt  DateTime @default(now())
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, ip, viewedAt])
}

enum ProfileStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ImageType {
  MAIN
  SECONDARY
  GALLERY
}
